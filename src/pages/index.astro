---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import FileUpload from '../components/FileUpload.astro';
import DiagramCanvas from '../components/DiagramCanvas.astro';
import ActivityLogs from '../components/ActivityLogs.astro';
import Footer from '../components/Footer.astro';
import config from '../data/site-config.json';
---
<Layout><Navbar /><main class="mx-auto max-w-7xl px-5 pb-16"><section class="grid gap-8 py-16 md:grid-cols-[1.1fr_.9fr] md:items-end md:py-24"><div><p class="text-xs font-semibold uppercase tracking-wider text-sky-500 dark:text-sky-400">{config.hero.eyebrow}</p><h1 class="mt-4 max-w-3xl text-4xl font-bold tracking-tight text-slate-950 dark:text-white md:text-6xl">{config.hero.headline}</h1><p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-700 dark:text-slate-300">{config.hero.subheadline}</p></div><div class="glass rounded-2xl p-6"><p class="text-sm font-semibold">{config.tagline}</p><p class="mt-3 text-sm leading-6 text-slate-700 dark:text-slate-300">{config.description}</p><div class="mt-6 grid grid-cols-3 gap-3 text-center">{config.stats.map((stat) => <div class="rounded-lg bg-slate-100 p-3 dark:bg-slate-800"><strong class="block text-2xl text-slate-900 dark:text-white">{stat.value}</strong><span class="text-xs font-medium text-slate-700 dark:text-slate-300">{stat.label}</span></div>)}</div></div></section><div class="grid gap-6 lg:grid-cols-[.85fr_1.15fr]"><FileUpload /><DiagramCanvas /></div><div class="mt-6"><ActivityLogs /></div></main><Footer /></Layout>
