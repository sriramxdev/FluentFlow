---
import config from '../data/site-config.json';
---
<footer class="mx-auto flex max-w-7xl flex-col gap-4 border-t border-slate-200 px-5 py-8 text-sm text-slate-700 dark:border-slate-700/80 dark:text-slate-300 md:flex-row md:items-center md:justify-between"><div><p class="font-medium text-slate-800 dark:text-slate-200">{config.author.name}</p><p>{config.author.role} · {config.footer.license}</p></div><div class="flex flex-wrap gap-2">{config.footer.badges.map((badge) => <span class="rounded-full border border-slate-200 px-2.5 py-1 text-xs dark:border-slate-700/80">{badge}</span>)}</div></footer>
