---
import supported from '../data/supported-types.json';
import presets from '../data/presets.json';
import config from '../data/site-config.json';
---
<section id="upload" class="glass rounded-2xl p-5 md:p-7">
  <div class="mb-5"><p class="text-xs font-semibold uppercase tracking-wider text-sky-500 dark:text-sky-400">{config.hero.eyebrow}</p><h2 class="mt-2 text-xl font-semibold">{config.labels.uploadTitle}</h2><p class="mt-1 text-sm text-slate-700 dark:text-slate-300">{config.labels.uploadDescription}</p></div>
  <div id="drop-zone" class="rounded-xl border border-dashed border-slate-300 p-5 transition hover:border-sky-400 dark:border-slate-700/80"><label for="spec-file" class="block cursor-pointer text-center"><span class="text-base font-semibold text-slate-800 dark:text-slate-100">{config.labels.uploadBrowse}</span><span class="mt-2 block font-mono text-sm text-sky-600 dark:text-sky-300">{supported.allowedExtensions.join(' · ')}</span><input id="spec-file" class="sr-only" type="file" accept={supported.accept} /></label></div>
  <p id="file-error" class="mt-3 hidden text-sm text-rose-500" role="alert">{supported.errorMessage}</p>
  <div class="my-5 flex items-center gap-3 text-xs text-slate-400"><span class="h-px flex-1 bg-slate-200 dark:bg-slate-700/80"></span><span>{config.labels.orPreset}</span><span class="h-px flex-1 bg-slate-200 dark:bg-slate-700/80"></span></div>
  <div class="grid gap-2 sm:grid-cols-3">{presets.map((preset) => <button type="button" class="preset rounded-lg border border-slate-200 px-3 py-3 text-left text-sm font-medium text-slate-800 transition hover:border-sky-400 dark:border-slate-700/80 dark:text-slate-100" data-snippet={preset.snippet}>{preset.name}</button>)}</div>
  <label class="mt-5 block text-sm font-medium" for="spec-input">{config.labels.specification}</label><textarea id="spec-input" rows="6" class="mt-2 w-full rounded-xl border border-slate-300 bg-transparent p-3 text-sm placeholder:text-slate-400 dark:border-slate-700" placeholder={config.labels.specificationPlaceholder}></textarea>
  <div class="mt-4 flex flex-wrap gap-3"><button id="generate-diagram" class="rounded-lg bg-sky-400 px-4 py-2.5 text-sm font-semibold text-slate-950 transition hover:bg-sky-300">{config.labels.generate}</button><button id="clear-workspace" class="rounded-lg border border-slate-300 px-4 py-2.5 text-sm dark:border-slate-700/80">{config.labels.clear}</button></div>
</section>
<script define:vars={{ allowedExtensions: supported.allowedExtensions, blockedMimePrefixes: ['image/'] }}>
  const input = document.querySelector('#spec-input'); const file = document.querySelector('#spec-file'); const error = document.querySelector('#file-error');
  const acceptFile = (selected) => { const extension = `.${selected.name.split('.').pop()?.toLowerCase()}`; const blocked = blockedMimePrefixes.some((prefix) => selected.type.startsWith(prefix)); if (!allowedExtensions.includes(extension) || blocked) { error?.classList.remove('hidden'); return; } error?.classList.add('hidden'); const reader = new FileReader(); reader.onload = () => { if (input) input.value = String(reader.result ?? ''); }; reader.readAsText(selected); };
  file?.addEventListener('change', () => file.files?.[0] && acceptFile(file.files[0]));
  const synthesize = () => { const text = document.querySelector('textarea')?.value || ''; window.dispatchEvent(new CustomEvent('fluentflow:synthesize', { detail: { text } })); };
  document.querySelectorAll('.preset').forEach((button) => button.addEventListener('click', () => { if (input) input.value = button.dataset.snippet ?? ''; synthesize(); }));
  document.querySelector('#clear-workspace')?.addEventListener('click', () => { if (input) input.value = ''; window.dispatchEvent(new CustomEvent('fluentflow-clear')); });
  document.querySelector('#generate-diagram')?.addEventListener('click', synthesize);
</script>
